  "trailing_slash_semantics": {
    "patterns_without_trailing_slash": {
      "patterns": [
        "*.d",
        "*.o",
        "*.ko"
      ],
      "behavior": "In Gitignore syntax, patterns without a trailing slash match both regular files and directories sharing the same extension. Hence, both file main.o and directory main.o/ are matched and ignored."
    },
    "patterns_with_trailing_slash": {
      "demonstration": {
        "tested_rule": "*.d/",
        "directory_check": {
          "path": "config.d/",
          "ignored": true,
          "pattern": "*.d/",
          "passed": true
        },
        "file_check": {
          "path": "main.d",
          "ignored": false,
          "passed": true
        },
        "porcelain_status": "?? main.d",
        "explanation": "When a pattern has a trailing slash (e.g. *.d/), Git restricts matching exclusively to directories. Therefore, directory 'config.d/' is ignored, but regular file 'main.d' remains unignored and visible in status as '?? main.d'. In contrast, C.gitignore uses bare patterns (*.d, *.o, *.ko) without trailing slashes, which match both regular files and directories sharing the same basename.",
        "passed": true
      },
      "behavior": "Appending a trailing slash (e.g. *.d/ or *.dSYM/) restricts the pattern exclusively to directory matching. Regular files sharing the name remain unignored and visible."
    }
  },
  "tracked_file_check": {
    "path": "main.o",
    "description": "Pre-tracked main.o modification remains tracked and visible in status --porcelain",
    "porcelain_status": "M main.o",
    "passed": true
  },
