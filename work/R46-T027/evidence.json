  "pattern_origin_analysis": {
    "origin": "LibreOffice Document Locking Protocol",
    "file_naming": ".~lock.<filename>#",
    "purpose": "When a document (e.g. document.odt) is opened in LibreOffice, a lock file named .~lock.document.odt# is automatically created in the same directory. It stores the username, computer name, and lock timestamp to prevent concurrent write collisions. The rule .~lock.*# ensures these temporary locking artifacts are never committed, while safely preserving all real documents (*.odt, *.ods, *.odp)."
  },
  "tracked_file_check": {
    "path": "annual_report.odt",
    "description": "Pre-tracked LibreOffice document remains tracked and visible in status --porcelain",
