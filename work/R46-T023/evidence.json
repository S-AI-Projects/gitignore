  "negation_precedence_demonstration": {
    "sequence_A_re_inclusion": {
      "rules": [
        "*.log",
        "!important.log"
      ],
      "explanation": "General rule *.log followed by explicit negation !important.log. Last match wins, re-including important.log.",
      "build_log": {
        "ignored": true,
        "pattern": "*.log",
        "raw": ".gitignore:1:*.log\tbuild.log"
      },
      "important_log": {
        "ignored": true,
        "pattern": "!important.log",
        "raw": ".gitignore:2:!important.log\timportant.log",
        "is_negated": true
      },
      "porcelain_status": "?? important.log",
      "re_included_visible_in_status": true
    },
    "sequence_B_overridden": {
      "rules": [
        "!important.log",
        "*.log"
      ],
      "explanation": "Negation !important.log followed by broader *.log. The later *.log overrides the negation, ignoring both files.",
      "build_log": {
        "ignored": true,
        "pattern": "*.log",
        "raw": ".gitignore:2:*.log\tbuild.log"
      },
      "important_log": {
        "ignored": true,
        "pattern": "*.log",
        "raw": ".gitignore:2:*.log\timportant.log",
        "is_negated": false
      },
      "porcelain_status": "",
      "both_ignored_clean_status": true
    }
  },
