    "check_ignore_pre_committed": {
      "exit_code": 0,
      "matches_rule": true,
      "output": ".gitignore:5:target\ttarget/pre_committed_artifact.txt"
    },
    "check_ignore_untracked": {
      "exit_code": 0,
      "matches_rule": true,
      "output": ".gitignore:5:target\ttarget/untracked_artifact.txt"
    },
    "status_before_edit": "",
    "status_after_edit": "M target/pre_committed_artifact.txt",
    "tracked_remains_tracked": true,
    "untracked_remains_hidden": true,
    "passed": true,
    "explanation": "Git ignore rules (.gitignore) only prevent UNTRACKED files from being added to the Git index. Files that were already committed/tracked in the index before the ignore rule was installed remain fully tracked by Git. While `git check-ignore` matches both files, `git status --porcelain` continues monitoring changes to the tracked file ('M target/pre_committed_artifact.txt') while completely hiding the untracked file."
  },
