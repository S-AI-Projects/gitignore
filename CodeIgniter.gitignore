# */config/development ignores the development-only configuration directory
# that holds database credentials and environment settings.
# */logs/log-*.php matches date-stamped CodeIgniter log files at any depth.
# !*/logs/index.html re-includes index.html so the logs directory itself
# (a plain directory listing gate) remains committed and tracked. A later
# !*/logs/index.html negation overrides an earlier ignore rule by last-match.
*/config/development
*/logs/log-*.php
!*/logs/index.html
*/cache/*
!system/cache/*
!*/cache/index.html
!*/cache/.htaccess

user_guide_src/build/*
user_guide_src/cilexer/build/*
user_guide_src/cilexer/dist/*
user_guide_src/cilexer/pycilexer.egg-info/*

#codeigniter 3
application/logs/*
!application/logs/index.html
!application/logs/.htaccess
/vendor/
